    if (any(greaterThanEqual(blockId, blocksPerAxis)))
        return;

    // Flatten block index (same idea as your old 'index')
    int index =
        blockId.x +
        blockId.y * blocksPerAxis.x +
        blockId.z * blocksPerAxis.x * blocksPerAxis.y;

    ivec3 localOffset = ivec3(gl_LocalInvocationID); // 0..8

    ivec3 blockBase = blockId * blockDim;
    ivec3 pos       = blockBase + localOffset;

    uint lid = gl_LocalInvocationIndex; // 0..728

    // Init shared vars once per block
    if (lid == 0u) {
        sGotHit        = 0u;
        sInsideBand    = 0u;
        sHasNegative   = 0u;
        sHasPositive   = 0u;
        sTouched       = 0u;
        sHasEmissive   = 0u;
        sInsideBandDis = 0.0;
    }
    barrier();

    // Check if this voxel is actually inside the 3D texture
    bool valid = !(
        any(lessThan(pos, ivec3(0))) ||
        any(greaterThanEqual(pos, dims))
    );

    float h = 100.01; // default far value
    vec4 sampleColor = vec4(0.0);

    if (valid) {
        vec3 p = pos- (dims/2.0);
        p = p/dims;

        float maxSmoothness = 0.0;
        bool sampleEmissive = false;
        for (int opIndex = 0; opIndex < ubo.DispatchMeta.w; ++opIndex) {
            CsgOperation op = csgOps[opIndex];
            float action = op.meta.x;
            int shapeMode = int(floor(op.meta.y + 0.5));
            float smoothness = max(op.meta.z, 0.0001);
            int flags = int(floor(op.meta.w + 0.5));
            maxSmoothness = max(maxSmoothness, smoothness);

            vec3 pq = p - op.centerRadius.xyz;
            float brushRadius = op.centerRadius.w;
            if (action < 0.5) {
                brushRadius *= 1.15;
            }

            float primitive = (shapeMode == 1)
                ? sdfSphere(pq, brushRadius)
                : sdfBox(pq, vec3(brushRadius));

            if ((flags & CSG_FLAG_RECOLOR) != 0) {
                if (primitive < 0.0 && h < 0.0) {
                    sampleColor = vec4(op.color.rgb, 1.0);
                    sampleEmissive = ((flags & CSG_FLAG_EMISSIVE) != 0);
                }
                continue;
            }

            if (action < 0.5) {
                h = smax(-primitive, h, smoothness);
            } else {
                h = smin(primitive, h, smoothness);
                if (primitive <= smoothness * 4.0) {
                    sampleColor = vec4(op.color.rgb, 1.0);
                    sampleEmissive = ((flags & CSG_FLAG_EMISSIVE) != 0);
                }
            }
        }

        float keepBand = max(maxSmoothness * 2.0, 2.0 / float(dims.x));
        bool hit         = (abs(h) <= keepBand);
        bool insideBand  = (h < -keepBand);
        bool hasNegative = (h < 0.0);
        bool hasPositive = (h > 0.0);

        if (hit) atomicAdd(sGotHit, 1u);
        if (insideBand) {
            atomicOr(sInsideBand, 1u);
            sInsideBandDis = h;
        }
        if (hasNegative) atomicOr(sHasNegative, 1u);
        if (hasPositive) atomicOr(sHasPositive, 1u);
        if ((hasNegative || hit) && sampleColor.a > 0.5) {
            atomicOr(sTouched, 1u);
            if (sampleEmissive) {
                atomicOr(sHasEmissive, 1u);
            }
        }
    }

    // Store per-thread value in shared array
    hShared[lid] = h;
    colorShared[lid] = sampleColor;

    barrier();

    bool groupGotHit = (sGotHit >= MIN_NEAR_SURFACE_SAMPLES);
    bool groupHasNegative = (sHasNegative != 0u);
    bool groupHasPositive = (sHasPositive != 0u);
    bool groupHasMaterial = (groupHasNegative && groupHasPositive) || (groupGotHit && groupHasNegative);

    // Block-level decision & brick allocation
    if (lid == 0u) {
        int blkRaw = blocks[index];
        int blkBase = (blkRaw & BLOCK_INDEX_MASK);
        int blkFlags = (sHasEmissive != 0u) ? BLOCK_EMISSIVE_FLAG : 0;
        if (groupHasMaterial) {
            if (blkRaw < 0) {
                blkBase = AllocateBrickBase();
            }

            vec3 colorAccum = vec3(0.0);
            float colorCount = 0.0;
            for (int i = 0; i < BRICK_STRIDE; ++i) {
                if (colorShared[i].a > 0.5 && (hShared[i] < 0.0 || abs(hShared[i]) <= 0.04)) {
                    colorAccum += colorShared[i].rgb;
                    colorCount += 1.0;
                }
            }
            blockColors[index] = (colorCount > 0.0)
                ? vec4(colorAccum / colorCount, 1.0)
                : blockColors[index];
            blocks[index] = blkBase | blkFlags;
        } else {
            if (blkRaw >= 0) {
                FreeBrickBase(blkBase);
            }
            blocks[index] = -999999;
        }
        if (blocks[index] >= 0) {
            atomicAdd(dirtyBlockCount, 1);
        }
    }

    barrier();

    // Write 9x9x9 brick for surface blocks
    if (ubo.BrushRecolor < 0.5 && groupHasMaterial && valid) {
        int base = (blocks[index] & BLOCK_INDEX_MASK);
        if (base >= 0) {
            bricks[base + int(lid)] = hShared[lid];
        }
    }
}
