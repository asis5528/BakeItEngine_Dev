#version 450

layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

layout(binding = 0) uniform computeUbo {
    vec4  BrushData;
    vec4  BrushColor;
    float BrushAction;
    float time;
    float BrushShape;
    float BrushSmoothness;
    float BrushEmissive;
    float BrushRecolor;
    float _pad0;
    float _pad1;
    ivec4 DispatchMeta;
} ubo;

layout(binding = 1) buffer CoarseBrickBuffer {
    float coarseBricks[];
};

layout(binding = 2) buffer CoarseBlockBuffer {
    int coarseBlocks[];
};

layout(binding = 3) buffer CoarseBlockColorBuffer {
    vec4 coarseBlockColors[];
};

struct CsgOperation {
    vec4 centerRadius;
    vec4 color;
    vec4 meta; // x action, y shape, z smoothness, w flags
};

layout(binding = 4) readonly buffer CsgOperationBuffer {
    CsgOperation csgOps[];
};

shared uint sGotHit;
shared uint sInsideBand;
shared uint sHasNegative;
shared uint sHasPositive;
shared uint sHasEmissive;
shared float hShared[9 * 9 * 9];
shared vec4 colorShared[9 * 9 * 9];

const int BLOCK_EMISSIVE_FLAG = (1 << 30);
const int BLOCK_INDEX_MASK = BLOCK_EMISSIVE_FLAG - 1;
const int BRICK_STRIDE = 9 * 9 * 9;
const int CSG_FLAG_EMISSIVE = 1;
const int CSG_FLAG_RECOLOR = 2;
const uint MIN_NEAR_SURFACE_SAMPLES = 6u;

int flatten3D(ivec3 p, ivec3 dims)
{
    return p.x + p.y * dims.x + p.z * dims.x * dims.y;
}

float smin(float a, float b, float k)
{
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float smax(float a, float b, float k)
{
    float h = clamp(0.5 - 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) + k * h * (1.0 - h);
}

float sdfBox(vec3 p, vec3 halfExtents)
{
    vec3 q = abs(p) - halfExtents;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdfSphere(vec3 p, float radius)
{
    return length(p) - radius;
}

void main()
{
    const ivec3 dims = ivec3(32 * 8); // 256^3 coarse replay domain
    const ivec3 blockDim = ivec3(8);
    const ivec3 blocksPerAxis = dims / blockDim; // 32^3

    ivec3 blockId = ivec3(gl_WorkGroupID);
    if (any(greaterThanEqual(blockId, blocksPerAxis))) {
        return;
    }

    const int blockIndex = flatten3D(blockId, blocksPerAxis);
    const int coarseBrickBase = blockIndex * BRICK_STRIDE;
    const ivec3 localOffset = ivec3(gl_LocalInvocationID);
    const ivec3 blockBase = blockId * blockDim;
    const ivec3 pos = blockBase + localOffset;
    const uint lid = gl_LocalInvocationIndex;

    if (lid == 0u) {
        sGotHit = 0u;
        sInsideBand = 0u;
        sHasNegative = 0u;
        sHasPositive = 0u;
        sHasEmissive = 0u;
    }
    barrier();

    bool valid = !(
        any(lessThan(pos, ivec3(0))) ||
        any(greaterThanEqual(pos, dims))
    );

    float h = 100.01;
    vec4 sampleColor = vec4(0.0);

    if (valid) {
        vec3 p = (vec3(pos) - (vec3(dims) * 0.5)) / vec3(dims);

        float maxSmoothness = 0.0;
        bool sampleEmissive = false;
        for (int opIndex = 0; opIndex < ubo.DispatchMeta.w; ++opIndex) {
            CsgOperation op = csgOps[opIndex];
            float action = op.meta.x;
            int shapeMode = int(floor(op.meta.y + 0.5));
            float smoothness = max(op.meta.z, 0.0001);
            int flags = int(floor(op.meta.w + 0.5));
            maxSmoothness = max(maxSmoothness, smoothness);

            vec3 pq = p - op.centerRadius.xyz;
            float brushRadius = op.centerRadius.w;
            if (action < 0.5) {
                brushRadius *= 1.15;
            }

            float primitive = (shapeMode == 1)
                ? sdfSphere(pq, brushRadius)
                : sdfBox(pq, vec3(brushRadius));

            if ((flags & CSG_FLAG_RECOLOR) != 0) {
                if (primitive < 0.0 && h < 0.0) {
                    sampleColor = vec4(op.color.rgb, 1.0);
                    sampleEmissive = ((flags & CSG_FLAG_EMISSIVE) != 0);
                }
                continue;
            }

            if (action < 0.5) {
                h = smax(-primitive, h, smoothness);
            } else {
                h = smin(primitive, h, smoothness);
                if (primitive <= smoothness * 4.0) {
                    sampleColor = vec4(op.color.rgb, 1.0);
                    sampleEmissive = ((flags & CSG_FLAG_EMISSIVE) != 0);
                }
            }
        }

        float keepBand = max(maxSmoothness * 2.0, 2.0 / float(dims.x));
        bool hit = (abs(h) <= keepBand);
        bool insideBand = (h < -keepBand);
        bool hasNegative = (h < 0.0);
        bool hasPositive = (h > 0.0);

        if (hit) {
            atomicAdd(sGotHit, 1u);
        }
        if (insideBand) {
            atomicOr(sInsideBand, 1u);
        }
        if (hasNegative) {
            atomicOr(sHasNegative, 1u);
        }
        if (hasPositive) {
            atomicOr(sHasPositive, 1u);
        }
        if ((hasNegative || hit) && sampleColor.a > 0.5 && sampleEmissive) {
            atomicOr(sHasEmissive, 1u);
        }
    }

    hShared[lid] = h;
    colorShared[lid] = sampleColor;
    barrier();

    bool groupHasMaterial = ((sHasNegative != 0u) && (sHasPositive != 0u)) || ((sGotHit >= MIN_NEAR_SURFACE_SAMPLES) && (sHasNegative != 0u));

    if (lid == 0u) {
        if (groupHasMaterial) {
            vec3 colorAccum = vec3(0.0);
            float colorCount = 0.0;
            for (int i = 0; i < BRICK_STRIDE; ++i) {
                if (colorShared[i].a > 0.5 && (hShared[i] < 0.0 || abs(hShared[i]) <= 0.04)) {
                    colorAccum += colorShared[i].rgb;
                    colorCount += 1.0;
                }
            }

            coarseBlocks[blockIndex] = coarseBrickBase | ((sHasEmissive != 0u) ? BLOCK_EMISSIVE_FLAG : 0);
            coarseBlockColors[blockIndex] = (colorCount > 0.0)
                ? vec4(colorAccum / colorCount, 1.0)
                : coarseBlockColors[blockIndex];
        } else {
            coarseBlocks[blockIndex] = -999999;
            coarseBlockColors[blockIndex] = vec4(0.0);
        }
    }

    barrier();

    if (groupHasMaterial && valid) {
        coarseBricks[coarseBrickBase + int(lid)] = hShared[lid];
    }
}
