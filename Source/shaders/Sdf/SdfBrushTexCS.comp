#version 450

// SdfBrushTexCS - texture-native variant of SdfBrushCS (DESKTOP TEST, behind
// BAKEIT_SDF_TEXTURE_ATLAS). Identical brush logic - boolean stamp, storage-
// class decision, brick allocation, free-list, colors - EXCEPT the field is
// stored in a SPARSE 3D-texture TILE POOL instead of the bricks[] SSBO:
//   - the allocator's "base" is a TILE INDEX (one tile per surface block),
//   - each block's 9^3 samples live in its own 9^3 tile (8 cells + 1 +pad),
//     self-contained so hardware trilinear never crosses into a neighbour tile,
//   - previous values are imageLoad-ed and new values imageStore-d.
// The block table, counter, colors, dirty and free-list SSBOs are unchanged, so
// the render and draw list keep working exactly as in the SSBO build.
//
// One workgroup per block, 9x9x9 threads (one per tile sample).

layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

layout(binding = 0) uniform computeUbo {
    vec4  BrushData;
    vec4  BrushColor;
    float BrushAction;
    float time;
    float BrushShape;
    float BrushSmoothness;
    float BrushEmissive;
    float BrushRecolor;
    float _pad0;
    float _pad1;
    ivec4 DispatchBaseBlock;
    ivec4 CoarseParams; // x: table-base offset into the shared coarse table/colors (0 for fine)
} ubo;

layout(binding = 1, r16f) uniform image3D tilePool; // sparse tile atlas (field)
layout(binding = 2) buffer BlockBuffer {
    int blocks[];
};
layout(binding = 3) buffer Counter {
    int counter;     // next free tile index (tile units, NOT floats)
    int allocCursor;
};
layout(binding = 4) buffer BlockColorBuffer {
    vec4 blockColors[];
};
layout(binding = 5) buffer DirtyCounter {
    int dirtyBlockCount;
};
layout(binding = 6) buffer FreeBrickCounter {
    int freeBrickCount;
};
layout(binding = 7) buffer FreeBrickStack {
    int freeBrickStack[];
};

const int BLOCK_EMISSIVE_FLAG = (1 << 30);
const int BLOCK_INDEX_MASK = BLOCK_EMISSIVE_FLAG - 1;

const int BLOCK_EMPTY = -999999;
const int BLOCK_INTERIOR = -999998;
const float FAR_VALUE = 100.01;

// Tile pool geometry - must match BAKEIT_SDF_TILE_TILES_PER_AXIS (SdfBackend.h)
// and the render constants in SdfBrickFS.frag.
const int TILES_PER_AXIS = 32;
const int TILE_DIM = 9; // 8 cells + 1 pad

// Field-storage precision: must match BAKEIT_SDF_TILE_R8 in SdfBackend.h and the
// same block in SdfBrickFS.frag. R8_SNORM holds [-1,1], so the normalized-chunk
// distance is scaled into that band on store and unscaled on sample. The scale
// comes from the UBO (_pad1) so the COARSE stamp can WIDEN the range to 32/N (fit
// its N-block cube) - that lets the coarse march skip an empty coarse cube in ~1
// step instead of crawling ~N/2. 0 (the fine stamp's default) means 32 (fine).
#define SDF_TILE_R8 1
#if SDF_TILE_R8
// Asymmetric encoding: surface biased to stored -0.6 (20% of [-1,1] inside / 80%
// outside) so the codes concentrate where the march + normal actually sample.
// Base scale 82 -> ~2.5 cells inside / ~10 outside; coarse levels widen it to 82/N
// via ubo._pad1. encode: sv = clamp(BIAS + d*scale,-1,1); decode: d = (sv-BIAS)/scale.
const float TILE_FIELD_BIAS = -0.6;
float tileFieldScale() { return (ubo._pad1 > 0.5) ? ubo._pad1 : 82.0; }
#else
const float TILE_FIELD_BIAS = 0.0;
float tileFieldScale() { return 1.0; }
#endif
float tileFieldInvScale() { return 1.0 / tileFieldScale(); }

shared uint  sTouched;
shared uint  sHasNegative;
shared uint  sHasPositive;
shared uint  sNearSurfaceCount;
shared int   sBrickBase; // tile index published by thread 0
shared float hShared[TILE_DIM * TILE_DIM * TILE_DIM];

// tile index -> pool texel of that tile's (0,0,0) sample.
ivec3 tileOriginTexel(int tileIndex)
{
    ivec3 tc = ivec3(
        tileIndex % TILES_PER_AXIS,
        (tileIndex / TILES_PER_AXIS) % TILES_PER_AXIS,
        tileIndex / (TILES_PER_AXIS * TILES_PER_AXIS));
    return tc * TILE_DIM;
}

int AllocateBrickBase()
{
    int idx = atomicAdd(allocCursor, 1);
    if (idx < ubo.DispatchBaseBlock.w) {
        return freeBrickStack[idx];
    }
    return atomicAdd(counter, 1); // one tile
}

void FreeBrickBase(int base)
{
    if (base < 0) {
        return;
    }
    int slot = atomicAdd(freeBrickCount, 1);
    freeBrickStack[slot] = base;
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// Smooth max, the erase-side mirror of smin (same polynomial, same blend band):
// a cut gets the same rounded fillet a draw gets, driven by the same knob.
float smax(float a, float b, float k) {
    return -smin(-a, -b, k);
}

// --- Brush shape SDFs (p relative to the brush center, r = brush radius) -----
// Mirror of SdfBrushCS.comp; keep mode<->name in sync with BrushShapeName().
float sdfSphere(vec3 p, float r) { return length(p) - r; }

float sdfBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdfRoundBox(vec3 p, float r) {
    float e = r * 0.3;
    return sdfBox(p, vec3(r - e)) - e;
}

float sdfPlanePatch(vec3 p, float r) { return sdfBox(p, vec3(r, 0.001, r)); }

float sdfTorus(vec3 p, float r) {
    vec2 q = vec2(length(p.xz) - r * 0.65, p.y);
    return length(q) - r * 0.35;
}

float sdfCylinder(vec3 p, float r) {
    vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r * 0.7, r);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

float sdfCappedCone(vec3 p, float h, float r1, float r2) {
    vec2 q = vec2(length(p.xz), p.y);
    vec2 k1 = vec2(r2, h);
    vec2 k2 = vec2(r2 - r1, 2.0 * h);
    vec2 ca = vec2(q.x - min(q.x, (q.y < 0.0) ? r1 : r2), abs(q.y) - h);
    vec2 cb = q - k1 + k2 * clamp(dot(k1 - q, k2) / dot(k2, k2), 0.0, 1.0);
    float s = (cb.x < 0.0 && ca.y < 0.0) ? -1.0 : 1.0;
    return s * sqrt(min(dot(ca, ca), dot(cb, cb)));
}
float sdfCone(vec3 p, float r) { return sdfCappedCone(p, r, r * 0.8, r * 0.05); }

float sdfCapsule(vec3 p, float r) {
    vec3 a = p; a.y -= clamp(a.y, -r * 0.55, r * 0.55);
    return length(a) - r * 0.45;
}

float sdfOctahedron(vec3 p, float r) {
    p = abs(p);
    return (p.x + p.y + p.z - r) * 0.57735027;
}

float sdfHexPrism(vec3 p, float r) {
    const vec3 k = vec3(-0.8660254, 0.5, 0.57735);
    p = abs(p);
    p.xy -= 2.0 * min(dot(k.xy, p.xy), 0.0) * k.xy;
    vec2 h = vec2(r * 0.7, r);
    vec2 d = vec2(
        length(p.xy - vec2(clamp(p.x, -k.z * h.x, k.z * h.x), h.x)) * sign(p.y - h.x),
        p.z - h.y);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

float sdfEllipsoid(vec3 p, float r) {
    vec3 rad = vec3(r * 0.95, r * 0.6, r * 0.95);
    float k0 = length(p / rad);
    float k1 = length(p / (rad * rad));
    return k0 * (k0 - 1.0) / max(k1, 1e-6);
}

float sdfPyramid(vec3 p, float r) {
    vec3 q = p / r;
    q.y += 0.5;
    const float h = 1.0;
    const float m2 = h * h + 0.25;
    q.xz = abs(q.xz);
    q.xz = (q.z > q.x) ? q.zx : q.xz;
    q.xz -= 0.5;
    vec3 w = vec3(q.z, h * q.y - 0.5 * q.x, h * q.x + 0.5 * q.y);
    float s = max(-w.x, 0.0);
    float t = clamp((w.y - 0.5 * q.z) / (m2 + 0.25), 0.0, 1.0);
    float a = m2 * (w.x + s) * (w.x + s) + w.y * w.y;
    float b = m2 * (w.x + 0.5 * t) * (w.x + 0.5 * t) + (w.y - m2 * t) * (w.y - m2 * t);
    float d2 = (min(w.y, -w.x * m2 - w.y * 0.5) > 0.0) ? 0.0 : min(a, b);
    return sqrt((d2 + w.z * w.z) / m2) * sign(max(w.z, -q.y)) * r;
}

float brushShapeSdf(vec3 p, float r, int mode) {
    if (mode == 1)  return sdfSphere(p, r);
    if (mode == 2)  return sdfPlanePatch(p, r);
    if (mode == 3)  return sdfRoundBox(p, r);
    if (mode == 4)  return sdfTorus(p, r);
    if (mode == 5)  return sdfCylinder(p, r);
    if (mode == 6)  return sdfCone(p, r);
    if (mode == 7)  return sdfCapsule(p, r);
    if (mode == 8)  return sdfOctahedron(p, r);
    if (mode == 9)  return sdfHexPrism(p, r);
    if (mode == 10) return sdfEllipsoid(p, r);
    if (mode == 11) return sdfPyramid(p, r);
    return sdfBox(p, vec3(r)); // 0 = cube (default)
}

void main()
{
    int gridCells = int(ubo._pad0 + 0.5);
    if (gridCells <= 0) { gridCells = 64 * 8; }
    const ivec3 dims = ivec3(gridCells);
    const ivec3 blockDim = ivec3(8);
    const ivec3 blocksPerAxis = dims / blockDim;

    ivec3 blockId = ivec3(gl_WorkGroupID) + ubo.DispatchBaseBlock.xyz;
    if (any(greaterThanEqual(blockId, blocksPerAxis)))
        return;

    int index =
        blockId.x +
        blockId.y * blocksPerAxis.x +
        blockId.z * blocksPerAxis.x * blocksPerAxis.y;
    // Shared coarse table/colors: this level's region starts at CoarseParams.x (0 for
    // fine). The tile pool itself is shared via the single allocation counter, so only
    // the per-block table/color writes need the per-level offset.
    index += ubo.CoarseParams.x;

    ivec3 localOffset = ivec3(gl_LocalInvocationID); // 0..8
    ivec3 pos = blockId * blockDim + localOffset;
    uint lid = gl_LocalInvocationIndex;              // 0..728

    if (lid == 0u) {
        sTouched = 0u;
        sHasNegative = 0u;
        sHasPositive = 0u;
        sNearSurfaceCount = 0u;
        sBrickBase = -1;
    }
    barrier();

    bool valid = all(lessThan(pos, dims));

    int blkRaw = blocks[index];
    int blkBase = (blkRaw & BLOCK_INDEX_MASK); // tile index for surface blocks

    float h = FAR_VALUE;
    if (valid) {
        // Previous stored value: this block's tile sample, or the sentinel.
        // Unscale the texel back to normalized-chunk distance (see TILE_FIELD_*).
        if (blkRaw >= 0) {
            // Un-bias then un-scale, the exact inverse of the biased store below.
            h = (imageLoad(tilePool, tileOriginTexel(blkBase) + localOffset).r - TILE_FIELD_BIAS) * tileFieldInvScale();
        } else if (blkRaw == BLOCK_INTERIOR) {
            h = -FAR_VALUE;
        } else {
            h = FAR_VALUE;
        }

        vec3 p = (vec3(pos) - vec3(dims) * 0.5) / vec3(dims);
        vec3 pq = p + ubo.BrushData.xyz - 0.031;

        float brushRadius = ubo.BrushData.w;
        if (ubo.BrushAction < 0.5) {
            brushRadius *= 1.15;
        }

        int shapeMode = int(floor(ubo.BrushShape + 0.5));
        float brush = brushShapeSdf(pq, brushRadius, shapeMode);

        if (brush < 0.0) {
            atomicOr(sTouched, 1u);
        }

        if (ubo.BrushRecolor < 0.5) {
            if (ubo.BrushAction < 0.5) {
                h = smax(-brush, h, max(ubo.BrushSmoothness, 0.0001));
            } else {
                h = smin(brush, h, max(ubo.BrushSmoothness, 0.0001));
            }
        }

        float keepBand = max(2.0 / float(dims.x), 2.0 * ubo.BrushSmoothness);
        if (abs(h) <= keepBand) {
            atomicAdd(sNearSurfaceCount, 1u);
        }
        if (h < 0.0) {
            atomicOr(sHasNegative, 1u);
        }
        if (h > 0.0) {
            atomicOr(sHasPositive, 1u);
        }
    }

    hShared[lid] = h;
    barrier();

    bool hasCrossing = (sHasNegative != 0u) && (sHasPositive != 0u);
    bool bandKeep = (sNearSurfaceCount > 0u) &&
        (ubo.BrushAction >= 0.5 || sHasNegative != 0u);
    bool hasSurface = hasCrossing || bandKeep;

    if (lid == 0u) {
        if (ubo.BrushRecolor > 0.5) {
            if (sTouched != 0u && blkRaw >= 0) {
                blockColors[index] = vec4(ubo.BrushColor.rgb, 1.0);
            }
        } else if (hasSurface) {
            int flags = (blkRaw >= 0) ? (blkRaw & BLOCK_EMISSIVE_FLAG) : 0;
            if (blkRaw < 0) {
                blkBase = AllocateBrickBase();
                flags = (ubo.BrushEmissive > 0.5 && ubo.BrushAction >= 0.5) ? BLOCK_EMISSIVE_FLAG : 0;
                blockColors[index] = vec4(ubo.BrushColor.rgb, 1.0);
            }
            blocks[index] = blkBase | flags;
            sBrickBase = blkBase;
            atomicAdd(dirtyBlockCount, 1);
        } else {
            if (blkRaw >= 0) {
                FreeBrickBase(blkBase);
            }
            blocks[index] = (sHasNegative != 0u) ? BLOCK_INTERIOR : BLOCK_EMPTY;
        }
    }
    barrier();

    // Write the tile samples for surface blocks. Scale into the texel's range and
    // offset by the surface bias (asymmetric encoding). R8_SNORM clamps to [-1,1]
    // in hardware, but clamp explicitly so the loaded-back value matches what
    // sampling sees (keeps accumulation consistent).
    if (sBrickBase >= 0 && ubo.BrushRecolor < 0.5) {
        float sv = hShared[lid] * tileFieldScale();
#if SDF_TILE_R8
        sv = clamp(TILE_FIELD_BIAS + sv, -1.0, 1.0);
#endif
        imageStore(tilePool, tileOriginTexel(sBrickBase) + localOffset, vec4(sv, 0.0, 0.0, 0.0));
    }
}
