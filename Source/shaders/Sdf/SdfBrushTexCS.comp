#version 450

// SdfBrushTexCS - texture-native variant of SdfBrushCS (DESKTOP TEST, behind
// BAKEIT_SDF_TEXTURE_ATLAS). Identical brush logic - boolean stamp, storage-
// class decision, brick allocation, free-list, colors - EXCEPT the field is
// stored in a SPARSE 3D-texture TILE POOL instead of the bricks[] SSBO:
//   - the allocator's "base" is a TILE INDEX (one tile per surface block),
//   - each block's 9^3 samples live in its own 9^3 tile (8 cells + 1 +pad),
//     self-contained so hardware trilinear never crosses into a neighbour tile,
//   - previous values are imageLoad-ed and new values imageStore-d.
// The block table, counter, colors, dirty and free-list SSBOs are unchanged, so
// the render and draw list keep working exactly as in the SSBO build.
//
// One workgroup per block, 9x9x9 threads (one per tile sample).

layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

layout(binding = 0) uniform computeUbo {
    vec4  BrushData;
    vec4  BrushColor;
    float BrushAction;
    float time;
    float BrushShape;
    float BrushSmoothness;
    float BrushEmissive;
    float BrushRecolor;
    float _pad0;
    float _pad1;
    ivec4 DispatchBaseBlock;
} ubo;

layout(binding = 1, r16f) uniform image3D tilePool; // sparse tile atlas (field)
layout(binding = 2) buffer BlockBuffer {
    int blocks[];
};
layout(binding = 3) buffer Counter {
    int counter;     // next free tile index (tile units, NOT floats)
    int allocCursor;
};
layout(binding = 4) buffer BlockColorBuffer {
    vec4 blockColors[];
};
layout(binding = 5) buffer DirtyCounter {
    int dirtyBlockCount;
};
layout(binding = 6) buffer FreeBrickCounter {
    int freeBrickCount;
};
layout(binding = 7) buffer FreeBrickStack {
    int freeBrickStack[];
};

const int BLOCK_EMISSIVE_FLAG = (1 << 30);
const int BLOCK_INDEX_MASK = BLOCK_EMISSIVE_FLAG - 1;

const int BLOCK_EMPTY = -999999;
const int BLOCK_INTERIOR = -999998;
const float FAR_VALUE = 100.01;

// Tile pool geometry - must match BAKEIT_SDF_TILE_TILES_PER_AXIS (SdfBackend.h)
// and the render constants in SdfBrickFS.frag.
const int TILES_PER_AXIS = 32;
const int TILE_DIM = 9; // 8 cells + 1 pad

shared uint  sTouched;
shared uint  sHasNegative;
shared uint  sHasPositive;
shared uint  sNearSurfaceCount;
shared int   sBrickBase; // tile index published by thread 0
shared float hShared[TILE_DIM * TILE_DIM * TILE_DIM];

// tile index -> pool texel of that tile's (0,0,0) sample.
ivec3 tileOriginTexel(int tileIndex)
{
    ivec3 tc = ivec3(
        tileIndex % TILES_PER_AXIS,
        (tileIndex / TILES_PER_AXIS) % TILES_PER_AXIS,
        tileIndex / (TILES_PER_AXIS * TILES_PER_AXIS));
    return tc * TILE_DIM;
}

int AllocateBrickBase()
{
    int idx = atomicAdd(allocCursor, 1);
    if (idx < ubo.DispatchBaseBlock.w) {
        return freeBrickStack[idx];
    }
    return atomicAdd(counter, 1); // one tile
}

void FreeBrickBase(int base)
{
    if (base < 0) {
        return;
    }
    int slot = atomicAdd(freeBrickCount, 1);
    freeBrickStack[slot] = base;
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float sdfBox(vec3 p, vec3 halfExtents) {
    vec3 q = abs(p) - halfExtents;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdfSphere(vec3 p, float radius) {
    return length(p) - radius;
}

float sdfPlanePatch(vec3 p, float radius) {
    return sdfBox(p, vec3(radius, 0.001, radius));
}

void main()
{
    int gridCells = int(ubo._pad0 + 0.5);
    if (gridCells <= 0) { gridCells = 64 * 8; }
    const ivec3 dims = ivec3(gridCells);
    const ivec3 blockDim = ivec3(8);
    const ivec3 blocksPerAxis = dims / blockDim;

    ivec3 blockId = ivec3(gl_WorkGroupID) + ubo.DispatchBaseBlock.xyz;
    if (any(greaterThanEqual(blockId, blocksPerAxis)))
        return;

    int index =
        blockId.x +
        blockId.y * blocksPerAxis.x +
        blockId.z * blocksPerAxis.x * blocksPerAxis.y;

    ivec3 localOffset = ivec3(gl_LocalInvocationID); // 0..8
    ivec3 pos = blockId * blockDim + localOffset;
    uint lid = gl_LocalInvocationIndex;              // 0..728

    if (lid == 0u) {
        sTouched = 0u;
        sHasNegative = 0u;
        sHasPositive = 0u;
        sNearSurfaceCount = 0u;
        sBrickBase = -1;
    }
    barrier();

    bool valid = all(lessThan(pos, dims));

    int blkRaw = blocks[index];
    int blkBase = (blkRaw & BLOCK_INDEX_MASK); // tile index for surface blocks

    float h = FAR_VALUE;
    if (valid) {
        // Previous stored value: this block's tile sample, or the sentinel.
        if (blkRaw >= 0) {
            h = imageLoad(tilePool, tileOriginTexel(blkBase) + localOffset).r;
        } else if (blkRaw == BLOCK_INTERIOR) {
            h = -FAR_VALUE;
        } else {
            h = FAR_VALUE;
        }

        vec3 p = (vec3(pos) - vec3(dims) * 0.5) / vec3(dims);
        vec3 pq = p + ubo.BrushData.xyz - 0.031;

        float brushRadius = ubo.BrushData.w;
        if (ubo.BrushAction < 0.5) {
            brushRadius *= 1.15;
        }

        int shapeMode = int(floor(ubo.BrushShape + 0.5));
        float brush;
        if (shapeMode == 1) {
            brush = sdfSphere(pq, brushRadius);
        } else if (shapeMode == 2) {
            brush = sdfPlanePatch(pq, brushRadius);
        } else {
            brush = sdfBox(pq, vec3(brushRadius));
        }

        if (brush < 0.0) {
            atomicOr(sTouched, 1u);
        }

        if (ubo.BrushRecolor < 0.5) {
            if (ubo.BrushAction < 0.5) {
                h = max(-brush, h);
            } else {
                h = smin(brush, h, max(ubo.BrushSmoothness, 0.0001));
            }
        }

        float keepBand = max(2.0 / float(dims.x), 2.0 * ubo.BrushSmoothness);
        if (abs(h) <= keepBand) {
            atomicAdd(sNearSurfaceCount, 1u);
        }
        if (h < 0.0) {
            atomicOr(sHasNegative, 1u);
        }
        if (h > 0.0) {
            atomicOr(sHasPositive, 1u);
        }
    }

    hShared[lid] = h;
    barrier();

    bool hasCrossing = (sHasNegative != 0u) && (sHasPositive != 0u);
    bool bandKeep = (sNearSurfaceCount > 0u) &&
        (ubo.BrushAction >= 0.5 || sHasNegative != 0u);
    bool hasSurface = hasCrossing || bandKeep;

    if (lid == 0u) {
        if (ubo.BrushRecolor > 0.5) {
            if (sTouched != 0u && blkRaw >= 0) {
                blockColors[index] = vec4(ubo.BrushColor.rgb, 1.0);
            }
        } else if (hasSurface) {
            int flags = (blkRaw >= 0) ? (blkRaw & BLOCK_EMISSIVE_FLAG) : 0;
            if (blkRaw < 0) {
                blkBase = AllocateBrickBase();
                flags = (ubo.BrushEmissive > 0.5 && ubo.BrushAction >= 0.5) ? BLOCK_EMISSIVE_FLAG : 0;
                blockColors[index] = vec4(ubo.BrushColor.rgb, 1.0);
            }
            blocks[index] = blkBase | flags;
            sBrickBase = blkBase;
            atomicAdd(dirtyBlockCount, 1);
        } else {
            if (blkRaw >= 0) {
                FreeBrickBase(blkBase);
            }
            blocks[index] = (sHasNegative != 0u) ? BLOCK_INTERIOR : BLOCK_EMPTY;
        }
    }
    barrier();

    // Write the tile samples for surface blocks.
    if (sBrickBase >= 0 && ubo.BrushRecolor < 0.5) {
        imageStore(tilePool, tileOriginTexel(sBrickBase) + localOffset, vec4(hShared[lid], 0.0, 0.0, 0.0));
    }
}
