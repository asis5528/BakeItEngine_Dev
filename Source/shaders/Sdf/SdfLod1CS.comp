#version 450

layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

layout(binding = 0) buffer FineBrickBuffer {
    float fineBricks[];
};

layout(binding = 1) buffer FineBlockBuffer {
    int fineBlocks[];
};

layout(binding = 2) buffer FineBlockColorBuffer {
    vec4 fineBlockColors[];
};

layout(binding = 3) buffer CoarseBrickBuffer {
    float coarseBricks[];
};

layout(binding = 4) buffer CoarseBlockBuffer {
    int coarseBlocks[];
};

layout(binding = 5) buffer CoarseBlockColorBuffer {
    vec4 coarseBlockColors[];
};

shared uint sGotHit;
shared uint sHasNegative;
shared uint sHasActiveChild;
shared float hShared[9 * 9 * 9];

const int BLOCK_EMISSIVE_FLAG = (1 << 30);
const int BLOCK_INDEX_MASK = BLOCK_EMISSIVE_FLAG - 1;
const int BRICK_STRIDE = 9 * 9 * 9;
const ivec3 FINE_BLOCKS = ivec3(64);
const ivec3 COARSE_BLOCKS = ivec3(32);
const int FINE_BLOCK_DIM = 8;
const float KEEP_BAND = 8.0 / 512.0;

int flatten3D(ivec3 p, ivec3 dims)
{
    return p.x + p.y * dims.x + p.z * dims.x * dims.y;
}

float sampleFineField(ivec3 fineSampleCoord)
{
    ivec3 clampedCoord = clamp(fineSampleCoord, ivec3(0), ivec3(512));
    ivec3 ownerCoord = max(clampedCoord - ivec3(1), ivec3(0));
    ivec3 fineBlock = min(ownerCoord / FINE_BLOCK_DIM, FINE_BLOCKS - ivec3(1));
    ivec3 localCoord = clampedCoord - fineBlock * FINE_BLOCK_DIM;

    int fineBlockIndex = flatten3D(fineBlock, FINE_BLOCKS);
    int fineRaw = fineBlocks[fineBlockIndex];
    if (fineRaw < 0) {
        return 100.01;
    }

    int fineBrickBase = fineRaw & BLOCK_INDEX_MASK;
    int fineSampleIndex = fineBrickBase + localCoord.x + localCoord.y * 9 + localCoord.z * 81;
    return fineBricks[fineSampleIndex];
}

float sampleFineFieldLinear(vec3 fineSampleCoord)
{
    vec3 clampedCoord = clamp(fineSampleCoord, vec3(0.0), vec3(512.0));
    ivec3 p0 = ivec3(floor(clampedCoord));
    ivec3 p1 = min(p0 + ivec3(1), ivec3(512));
    vec3 f = fract(clampedCoord);

    float c000 = sampleFineField(ivec3(p0.x, p0.y, p0.z));
    float c100 = sampleFineField(ivec3(p1.x, p0.y, p0.z));
    float c010 = sampleFineField(ivec3(p0.x, p1.y, p0.z));
    float c110 = sampleFineField(ivec3(p1.x, p1.y, p0.z));
    float c001 = sampleFineField(ivec3(p0.x, p0.y, p1.z));
    float c101 = sampleFineField(ivec3(p1.x, p0.y, p1.z));
    float c011 = sampleFineField(ivec3(p0.x, p1.y, p1.z));
    float c111 = sampleFineField(ivec3(p1.x, p1.y, p1.z));

    float c00 = mix(c000, c100, f.x);
    float c10 = mix(c010, c110, f.x);
    float c01 = mix(c001, c101, f.x);
    float c11 = mix(c011, c111, f.x);
    float c0 = mix(c00, c10, f.y);
    float c1 = mix(c01, c11, f.y);
    return mix(c0, c1, f.z);
}

vec3 computeFineSampleCoord(ivec3 coarseBlockId, ivec3 localCoord)
{
    const float scale = 2.0;
    vec3 blockBase = vec3(coarseBlockId) * 16.0;
    vec3 samplePos = blockBase + vec3(localCoord) * scale;
    if (all(equal(localCoord, ivec3(8)))) {
        return samplePos;
    }
    return samplePos + vec3(0.5);
}

void main()
{
    ivec3 coarseBlockId = ivec3(gl_WorkGroupID);
    if (any(greaterThanEqual(coarseBlockId, COARSE_BLOCKS))) {
        return;
    }

    uint lid = gl_LocalInvocationIndex;
    ivec3 localCoord = ivec3(gl_LocalInvocationID);
    int coarseBlockIndex = flatten3D(coarseBlockId, COARSE_BLOCKS);
    int coarseBrickBase = coarseBlockIndex * BRICK_STRIDE;

    if (lid == 0u) {
        sGotHit = 0u;
        sHasNegative = 0u;
        sHasActiveChild = 0u;
    }
    barrier();

    vec3 fineSampleCoord = computeFineSampleCoord(coarseBlockId, localCoord);
    float h = sampleFineFieldLinear(fineSampleCoord);

    if (abs(h) <= KEEP_BAND) {
        atomicOr(sGotHit, 1u);
    }
    if (h < 0.0) {
        atomicOr(sHasNegative, 1u);
    }

    hShared[lid] = h;
    barrier();

    bool groupHasMaterial = (sHasNegative != 0u) || (sGotHit != 0u) || (sHasActiveChild != 0u);

    if (lid == 0u) {
        int emissiveFlag = 0;
        vec4 colorAccum = vec4(0.0);
        float activeChildren = 0.0;
        ivec3 childBase = coarseBlockId * 2;

        for (int z = 0; z < 2; ++z) {
            for (int y = 0; y < 2; ++y) {
                for (int x = 0; x < 2; ++x) {
                    ivec3 childBlock = childBase + ivec3(x, y, z);
                    int childIndex = flatten3D(childBlock, FINE_BLOCKS);
                    int childRaw = fineBlocks[childIndex];
                    if (childRaw >= 0) {
                        sHasActiveChild = 1u;
                        colorAccum += fineBlockColors[childIndex];
                        activeChildren += 1.0;
                        if ((childRaw & BLOCK_EMISSIVE_FLAG) != 0) {
                            emissiveFlag = BLOCK_EMISSIVE_FLAG;
                        }
                    }
                }
            }
        }

        if (groupHasMaterial) {
            coarseBlocks[coarseBlockIndex] = coarseBrickBase | emissiveFlag;
            coarseBlockColors[coarseBlockIndex] =
                (activeChildren > 0.0) ? (colorAccum / activeChildren) : vec4(1.0);
        } else {
            coarseBlocks[coarseBlockIndex] = -999999;
            coarseBlockColors[coarseBlockIndex] = vec4(0.0);
        }
    }

    barrier();

    if (groupHasMaterial) {
        coarseBricks[coarseBrickBase + int(lid)] = hShared[lid];
    }
}
