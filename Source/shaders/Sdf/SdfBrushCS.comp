#version 450

// SdfBrushCS - applies one brush stamp to the scene SDF stored in the brick
// atlas. The brush is an analytic SDF (cube/sphere/plane with smoothness);
// each stamp is a complete boolean update of every block in the dispatch
// region:
//
//   add    : stored = smin(brushSDF, stored, smoothness)
//   remove : stored = max(-brushSDF, stored)
//
// Stamps are final - there is no later resolve pass. Per block the kernel
// decides the storage class from the new values:
//   surface  (sign crossing / near-surface samples) -> brick allocated, 9^3
//             samples written (8 cells + 1 padding sample shared with the
//             +X/+Y/+Z neighbor)
//   interior (all samples deep negative)            -> brick freed,
//             blocks[] = BLOCK_INTERIOR sentinel (solid, no surface)
//   empty    (all samples positive)                 -> brick freed,
//             blocks[] = BLOCK_EMPTY sentinel
//
// One workgroup per block, 9x9x9 threads (one per brick sample).

layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

layout(binding = 0) uniform computeUbo {
    vec4  BrushData;     // xyz: negated brush center (chunk local), w: radius
    vec4  BrushColor;
    float BrushAction;   // 1.0 add, 0.0 remove
    float time;
    float BrushShape;    // 0.0 cube, 1.0 sphere, 2.0 plane
    float BrushSmoothness;
    float BrushEmissive; // 1.0 emissive paint mode, 0.0 default
    float BrushRecolor;  // 1.0 recolor existing touched blocks only
    float _pad0;
    float _pad1;
    ivec4 DispatchBaseBlock; // xyz: region origin for partial dispatches,
                             // w: allocatable (stable) free-stack entry count
} ubo;

layout(binding = 1) buffer BrickBuffer {
    float bricks[];
};
layout(binding = 2) buffer BlockBuffer {
    int blocks[];
};
layout(binding = 3) buffer Counter {
    int counter;     // atlas tail (in floats)
    int allocCursor; // free-stack pop cursor for this dispatch (CPU resets it)
};
layout(binding = 4) buffer BlockColorBuffer {
    vec4 blockColors[];
};
layout(binding = 5) buffer DirtyCounter {
    int dirtyBlockCount;
};
layout(binding = 6) buffer FreeBrickCounter {
    int freeBrickCount;
};
layout(binding = 7) buffer FreeBrickStack {
    int freeBrickStack[];
};

const int BLOCK_EMISSIVE_FLAG = (1 << 30);
const int BLOCK_INDEX_MASK = BLOCK_EMISSIVE_FLAG - 1;
const int BRICK_STRIDE = 9 * 9 * 9;

// Brick-less storage classes (blocks[] < 0).
const int BLOCK_EMPTY = -999999;    // outside the shape, value = +FAR
const int BLOCK_INTERIOR = -999998; // deep inside the shape, value = -FAR
const float FAR_VALUE = 100.01;

shared uint  sTouched;
shared uint  sHasNegative;
shared uint  sHasPositive;
shared uint  sNearSurfaceCount;
shared int   sBrickBase; // allocation result published by thread 0
shared float hShared[BRICK_STRIDE];

// Free-stack discipline: allocation and freeing run concurrently within one
// dispatch, so a brick freed in this dispatch must NOT be reused in it -
// popping the slot another workgroup is still pushing reads a garbage brick
// index (rendered as glitch cubes), and racing pops could drive the counter
// negative (out-of-bounds pushes). Instead, pops consume the stable bottom
// of the stack ([0, DispatchBaseBlock.w), the count snapshotted by the CPU
// at submit) via allocCursor, while frees push on top via freeBrickCount.
// The two ranges never overlap; the CPU compacts the stack between stamps.
int AllocateBrickBase()
{
    int idx = atomicAdd(allocCursor, 1);
    if (idx < ubo.DispatchBaseBlock.w) {
        return freeBrickStack[idx];
    }
    return atomicAdd(counter, BRICK_STRIDE);
}

void FreeBrickBase(int base)
{
    if (base < 0) {
        return;
    }
    int slot = atomicAdd(freeBrickCount, 1);
    freeBrickStack[slot] = base;
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float sdfBox(vec3 p, vec3 halfExtents) {
    vec3 q = abs(p) - halfExtents;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdfSphere(vec3 p, float radius) {
    return length(p) - radius;
}

float sdfPlanePatch(vec3 p, float radius) {
    // Finite flat plane brush: square on XZ with small Y thickness.
    return sdfBox(p, vec3(radius, 0.001, radius));
}

void main()
{
    const ivec3 dims = ivec3(64 * 8);       // 512^3 sample domain
    const ivec3 blockDim = ivec3(8);
    const ivec3 blocksPerAxis = dims / blockDim;

    ivec3 blockId = ivec3(gl_WorkGroupID) + ubo.DispatchBaseBlock.xyz;
    // Uniform for the whole workgroup: safe to return before any barrier.
    if (any(greaterThanEqual(blockId, blocksPerAxis)))
        return;

    int index =
        blockId.x +
        blockId.y * blocksPerAxis.x +
        blockId.z * blocksPerAxis.x * blocksPerAxis.y;

    ivec3 localOffset = ivec3(gl_LocalInvocationID); // 0..8
    ivec3 pos = blockId * blockDim + localOffset;
    uint lid = gl_LocalInvocationIndex;              // 0..728

    if (lid == 0u) {
        sTouched = 0u;
        sHasNegative = 0u;
        sHasPositive = 0u;
        sNearSurfaceCount = 0u;
        sBrickBase = -1;
    }
    barrier();

    // Padding samples of edge blocks fall outside the domain; keep them FAR.
    bool valid = all(lessThan(pos, dims));

    int blkRaw = blocks[index];
    int blkBase = (blkRaw & BLOCK_INDEX_MASK);

    float h = FAR_VALUE;
    if (valid) {
        // Previous stored value: brick sample, or the sentinel constant.
        if (blkRaw >= 0) {
            h = bricks[blkBase + int(lid)];
        } else if (blkRaw == BLOCK_INTERIOR) {
            h = -FAR_VALUE;
        } else {
            h = FAR_VALUE;
        }

        // Sample position in chunk-local space [-0.5, 0.5).
        vec3 p = (vec3(pos) - vec3(dims) * 0.5) / vec3(dims);
        vec3 pq = p + ubo.BrushData.xyz - 0.031; // kBrushCenterBias

        float brushRadius = ubo.BrushData.w;
        if (ubo.BrushAction < 0.5) {
            brushRadius *= 1.15; // remove is slightly larger than add
        }

        int shapeMode = int(floor(ubo.BrushShape + 0.5));
        float brush;
        if (shapeMode == 1) {
            brush = sdfSphere(pq, brushRadius);
        } else if (shapeMode == 2) {
            brush = sdfPlanePatch(pq, brushRadius);
        } else {
            brush = sdfBox(pq, vec3(brushRadius));
        }

        if (brush < 0.0) {
            atomicOr(sTouched, 1u);
        }

        // Boolean update (skipped in recolor mode).
        if (ubo.BrushRecolor < 0.5) {
            if (ubo.BrushAction < 0.5) {
                h = max(-brush, h);
            } else {
                h = smin(brush, h, max(ubo.BrushSmoothness, 0.0001));
            }
        }

        // Band of samples that must keep their real values. Freeing a block
        // quantizes its samples to +-FAR, so the band has to cover everything
        // a future stamp's smooth union could blend with - otherwise the
        // re-stamped block disagrees with its kept neighbors at the shared
        // boundary samples and a crease appears in the surface.
        float keepBand = max(2.0 / float(dims.x), 2.0 * ubo.BrushSmoothness);
        if (abs(h) <= keepBand) {
            atomicAdd(sNearSurfaceCount, 1u);
        }
        if (h < 0.0) {
            atomicOr(sHasNegative, 1u);
        }
        if (h > 0.0) {
            atomicOr(sHasPositive, 1u);
        }
    }

    hShared[lid] = h;
    barrier();

    bool hasCrossing = (sHasNegative != 0u) && (sHasPositive != 0u);
    // A single in-band sample is enough to keep the brick: freeing a block
    // that grazes the surface at a corner/edge discards values its neighbors
    // still store, and the mismatch renders as crease lines along block
    // boundaries when the block is stamped again later.
    bool hasSurface = hasCrossing || (sNearSurfaceCount > 0u);

    // Block-level storage decision (thread 0 only).
    if (lid == 0u) {
        if (ubo.BrushRecolor > 0.5) {
            if (sTouched != 0u && blkRaw >= 0) {
                blockColors[index] = vec4(ubo.BrushColor.rgb, 1.0);
            }
        } else if (hasSurface) {
            int flags = (blkRaw >= 0) ? (blkRaw & BLOCK_EMISSIVE_FLAG) : 0;
            if (blkRaw < 0) {
                blkBase = AllocateBrickBase();
                // Emissive applies only to newly created blocks while ON.
                flags = (ubo.BrushEmissive > 0.5 && ubo.BrushAction >= 0.5) ? BLOCK_EMISSIVE_FLAG : 0;
                blockColors[index] = vec4(ubo.BrushColor.rgb, 1.0);
            }
            blocks[index] = blkBase | flags;
            sBrickBase = blkBase;
            atomicAdd(dirtyBlockCount, 1);
        } else {
            // No surface left in this block: return its brick to the free
            // list and store the constant-class sentinel.
            if (blkRaw >= 0) {
                FreeBrickBase(blkBase);
            }
            blocks[index] = (sHasNegative != 0u) ? BLOCK_INTERIOR : BLOCK_EMPTY;
        }
    }
    barrier();

    // Write the brick samples for surface blocks.
    if (sBrickBase >= 0 && ubo.BrushRecolor < 0.5) {
        bricks[sBrickBase + int(lid)] = hShared[lid];
    }
}
