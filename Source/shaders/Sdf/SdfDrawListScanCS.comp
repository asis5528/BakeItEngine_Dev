#version 450

// SdfDrawList pass 2/3 (scan): one workgroup turns the 256 bucket counts into
// exclusive start offsets (in place) and writes the total active-block count
// straight into the indirect draw command's instanceCount.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Buckets {
    uint buckets[]; // in: counts, out: exclusive offsets
};
layout(std430, binding = 1) buffer DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

const int NUM_BUCKETS = 256;

shared uint temp[NUM_BUCKETS];

void main()
{
    uint i = gl_LocalInvocationID.x;
    uint count = buckets[i];
    temp[i] = count;
    barrier();

    // Hillis-Steele inclusive scan in shared memory.
    for (uint offset = 1u; offset < uint(NUM_BUCKETS); offset <<= 1u) {
        uint v = temp[i];
        if (i >= offset) {
            v += temp[i - offset];
        }
        barrier();
        temp[i] = v;
        barrier();
    }

    // Exclusive offset = inclusive sum minus own count.
    buckets[i] = temp[i] - count;

    if (i == uint(NUM_BUCKETS) - 1u) {
        instanceCount = temp[i]; // total active blocks
    }
}
