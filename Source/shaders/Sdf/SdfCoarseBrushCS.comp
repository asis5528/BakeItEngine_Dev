#version 450

// SdfCoarseBrushCS - coarse-LOD brush stamp that stores the coarse distance
// field in a DENSE 3D TEXTURE instead of a sparse SSBO brick atlas.
//
// The coarse domain is small - 16 coarse blocks x 8 cells = 128, +1 boundary
// sample = 129^3 - so one dense 3D texture holds the whole field. Each thread
// writes its sample with imageStore; the render samples it with a sampler3D
// (hardware trilinear), so there is no per-brick tile addressing, no brick
// allocation, and no apron. The coarse block table (binding 2) is still written
// so SdfBrickVS knows which coarse cubes carry a surface.
//
// One workgroup per coarse block, 9x9x9 threads. Each block stores only its own
// 8^3 cells (local 0..7); the shared +face sample belongs to the neighbour
// block, so no two workgroups ever write the same texel (no store race).

layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

layout(binding = 0) uniform computeUbo {
    vec4  BrushData;     // xyz: negated brush center (chunk local), w: radius
    vec4  BrushColor;
    float BrushAction;   // 1.0 add, 0.0 remove
    float time;
    float BrushShape;    // 0.0 cube, 1.0 sphere, 2.0 plane
    float BrushSmoothness;
    float BrushEmissive;
    float BrushRecolor;
    float _pad0;         // coarse grid cells (128)
    float _pad1;
    ivec4 DispatchBaseBlock; // xyz: coarse region origin; w unused here
} ubo;

// The dense coarse field. Same image is bound to the render as a sampler3D
// (binding 2 there) - written here, read there, both in GENERAL layout.
layout(binding = 1, r16f) uniform image3D coarseAtlas;

layout(binding = 2) buffer BlockBuffer {
    int blocks[];        // coarse block table (16^3): >=0 surface, else sentinel
};

const int   BLOCK_EMPTY = -999999;    // outside the shape
const int   BLOCK_INTERIOR = -999998; // deep inside the shape
const float FAR_VALUE = 100.01;

shared uint sHasNegative;
shared uint sHasPositive;
shared uint sNearSurfaceCount;

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// Smooth max, the erase-side mirror of smin (same polynomial, same blend band):
// a cut gets the same rounded fillet a draw gets, driven by the same knob.
float smax(float a, float b, float k) {
    return -smin(-a, -b, k);
}
// --- Brush shape SDFs (mirror of SdfBrushCS.comp; see BrushShapeName()) ------
float sdfSphere(vec3 p, float r) { return length(p) - r; }
float sdfBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}
float sdfRoundBox(vec3 p, float r) { float e = r * 0.3; return sdfBox(p, vec3(r - e)) - e; }
float sdfPlanePatch(vec3 p, float r) { return sdfBox(p, vec3(r, 0.001, r)); }
float sdfTorus(vec3 p, float r) { vec2 q = vec2(length(p.xz) - r * 0.65, p.y); return length(q) - r * 0.35; }
float sdfCylinder(vec3 p, float r) {
    vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r * 0.7, r);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}
float sdfCappedCone(vec3 p, float h, float r1, float r2) {
    vec2 q = vec2(length(p.xz), p.y);
    vec2 k1 = vec2(r2, h);
    vec2 k2 = vec2(r2 - r1, 2.0 * h);
    vec2 ca = vec2(q.x - min(q.x, (q.y < 0.0) ? r1 : r2), abs(q.y) - h);
    vec2 cb = q - k1 + k2 * clamp(dot(k1 - q, k2) / dot(k2, k2), 0.0, 1.0);
    float s = (cb.x < 0.0 && ca.y < 0.0) ? -1.0 : 1.0;
    return s * sqrt(min(dot(ca, ca), dot(cb, cb)));
}
float sdfCone(vec3 p, float r) { return sdfCappedCone(p, r, r * 0.8, r * 0.05); }
float sdfCapsule(vec3 p, float r) { vec3 a = p; a.y -= clamp(a.y, -r * 0.55, r * 0.55); return length(a) - r * 0.45; }
float sdfOctahedron(vec3 p, float r) { p = abs(p); return (p.x + p.y + p.z - r) * 0.57735027; }
float sdfHexPrism(vec3 p, float r) {
    const vec3 k = vec3(-0.8660254, 0.5, 0.57735);
    p = abs(p);
    p.xy -= 2.0 * min(dot(k.xy, p.xy), 0.0) * k.xy;
    vec2 h = vec2(r * 0.7, r);
    vec2 d = vec2(length(p.xy - vec2(clamp(p.x, -k.z * h.x, k.z * h.x), h.x)) * sign(p.y - h.x), p.z - h.y);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}
float sdfEllipsoid(vec3 p, float r) {
    vec3 rad = vec3(r * 0.95, r * 0.6, r * 0.95);
    float k0 = length(p / rad); float k1 = length(p / (rad * rad));
    return k0 * (k0 - 1.0) / max(k1, 1e-6);
}
float sdfPyramid(vec3 p, float r) {
    vec3 q = p / r; q.y += 0.5;
    const float h = 1.0; const float m2 = h * h + 0.25;
    q.xz = abs(q.xz); q.xz = (q.z > q.x) ? q.zx : q.xz; q.xz -= 0.5;
    vec3 w = vec3(q.z, h * q.y - 0.5 * q.x, h * q.x + 0.5 * q.y);
    float s = max(-w.x, 0.0);
    float t = clamp((w.y - 0.5 * q.z) / (m2 + 0.25), 0.0, 1.0);
    float a = m2 * (w.x + s) * (w.x + s) + w.y * w.y;
    float b = m2 * (w.x + 0.5 * t) * (w.x + 0.5 * t) + (w.y - m2 * t) * (w.y - m2 * t);
    float d2 = (min(w.y, -w.x * m2 - w.y * 0.5) > 0.0) ? 0.0 : min(a, b);
    return sqrt((d2 + w.z * w.z) / m2) * sign(max(w.z, -q.y)) * r;
}
float brushShapeSdf(vec3 p, float r, int mode) {
    if (mode == 1)  return sdfSphere(p, r);
    if (mode == 2)  return sdfPlanePatch(p, r);
    if (mode == 3)  return sdfRoundBox(p, r);
    if (mode == 4)  return sdfTorus(p, r);
    if (mode == 5)  return sdfCylinder(p, r);
    if (mode == 6)  return sdfCone(p, r);
    if (mode == 7)  return sdfCapsule(p, r);
    if (mode == 8)  return sdfOctahedron(p, r);
    if (mode == 9)  return sdfHexPrism(p, r);
    if (mode == 10) return sdfEllipsoid(p, r);
    if (mode == 11) return sdfPyramid(p, r);
    return sdfBox(p, vec3(r));
}

void main()
{
    int gridCells = int(ubo._pad0 + 0.5);
    if (gridCells <= 0) { gridCells = 16 * 8; }
    const ivec3 dims = ivec3(gridCells);
    const ivec3 blockDim = ivec3(8);
    const ivec3 blocksPerAxis = dims / blockDim;

    ivec3 blockId = ivec3(gl_WorkGroupID) + ubo.DispatchBaseBlock.xyz;
    if (any(greaterThanEqual(blockId, blocksPerAxis)))
        return;

    int index =
        blockId.x +
        blockId.y * blocksPerAxis.x +
        blockId.z * blocksPerAxis.x * blocksPerAxis.y;

    ivec3 localOffset = ivec3(gl_LocalInvocationID); // 0..8
    ivec3 pos = blockId * blockDim + localOffset;
    uint lid = gl_LocalInvocationIndex;

    if (lid == 0u) {
        sHasNegative = 0u;
        sHasPositive = 0u;
        sNearSurfaceCount = 0u;
    }
    barrier();

    // Previous field value straight from the dense texture (pre-cleared to
    // +FAR, so the first stamp's smin/boolean starts clean). No sentinels: the
    // texture always holds the real (continuous) field.
    float h = imageLoad(coarseAtlas, pos).r;

    vec3 p = (vec3(pos) - vec3(dims) * 0.5) / vec3(dims);
    vec3 pq = p + ubo.BrushData.xyz - 0.031; // kBrushCenterBias

    float brushRadius = ubo.BrushData.w;
    if (ubo.BrushAction < 0.5) {
        brushRadius *= 1.15;
    }

    int shapeMode = int(floor(ubo.BrushShape + 0.5));
    float brush = brushShapeSdf(pq, brushRadius, shapeMode);

    if (ubo.BrushAction < 0.5) {
        h = smax(-brush, h, max(ubo.BrushSmoothness, 0.0001));
    } else {
        h = smin(brush, h, max(ubo.BrushSmoothness, 0.0001));
    }

    float keepBand = max(2.0 / float(dims.x), 2.0 * ubo.BrushSmoothness);
    if (abs(h) <= keepBand) {
        atomicAdd(sNearSurfaceCount, 1u);
    }
    if (h < 0.0) {
        atomicOr(sHasNegative, 1u);
    }
    if (h > 0.0) {
        atomicOr(sHasPositive, 1u);
    }
    barrier();

    // Store only this block's own 8^3 cells (local 0..7). The +face sample is
    // owned by the neighbour block, so coverage is exact with no overlap.
    if (all(lessThan(localOffset, ivec3(8)))) {
        imageStore(coarseAtlas, pos, vec4(h, 0.0, 0.0, 0.0));
    }

    // Block-level surface decision (thread 0). See SdfBrushCS for the band /
    // remove-exception rationale; the coarse field has no bricks to free.
    if (lid == 0u) {
        bool hasCrossing = (sHasNegative != 0u) && (sHasPositive != 0u);
        bool bandKeep = (sNearSurfaceCount > 0u) &&
            (ubo.BrushAction >= 0.5 || sHasNegative != 0u);
        bool hasSurface = hasCrossing || bandKeep;
        if (hasSurface) {
            blocks[index] = 0; // >=0: VS emits this coarse cube
        } else {
            blocks[index] = (sHasNegative != 0u) ? BLOCK_INTERIOR : BLOCK_EMPTY;
        }
    }
}
